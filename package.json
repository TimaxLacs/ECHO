{
  "name": "echo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Личный агент Эхо: слоты мозга, памяти, голоса и инструментов",
  "type": "module",
  "bin": {
    "echo": "./src/cli.ts"
  },
  "scripts": {
