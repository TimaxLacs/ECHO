{
  "name": "echo-agent",
  "version": "0.1.0",
  "description": "Universal personal agent runtime: slots for any brain, voice, memory, channel, and tools",
  "type": "module",
  "bin": {
    "echo-agent": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
