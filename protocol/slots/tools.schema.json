{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.agent/protocol/echo.v1/slots/tools.json",
  "title": "tools",
  "description": "Мультиплексор MCP/шелл/харнесс. Снаружи для runtime это list и call.",
  "oneOf": [
    {
      "title": "tools.list",
      "type": "object",
      "additionalProperties": true
    },
    {
      "title": "tools.call",
      "type": "object",
      "required": ["name", "arguments"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "arguments": { "type": "object" }
      }
    }
  ]
}
