{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.agent/protocol/echo.v1/slots/llm.json",
  "title": "llm.complete",
  "description": "Мозг не ходит в память и не вызывает инструменты. Runtime передаёт tools и сам делает tools.call.",
  "type": "object",
  "required": ["messages"],
  "additionalProperties": true,
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant", "tool"] },
          "content": { "type": "string" },
          "name": { "type": "string" },
          "tool_call_id": { "type": "string" },
          "tool_calls": { "type": "array" }
        }
      }
    },
    "tools": { "type": "array" }
  }
}
