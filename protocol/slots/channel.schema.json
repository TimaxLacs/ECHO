{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.agent/protocol/echo.v1/slots/channel.json",
  "title": "channel",
  "description": "Единственный слот, который пушит в runtime (channel.turn) и принимает deliver.",
  "oneOf": [
    {
      "title": "channel.turn",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "text": { "type": "string" },
        "audio": { "$ref": "../blob-ref.schema.json" }
      }
    },
    {
      "title": "channel.deliver",
      "type": "object",
      "required": ["text"],
      "additionalProperties": true,
      "properties": {
        "text": { "type": "string" },
        "audio": { "$ref": "../blob-ref.schema.json" },
        "dest": { "type": "string" }
      }
    }
  ]
}
