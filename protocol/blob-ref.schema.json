{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.agent/protocol/echo.v1/blob-ref.json",
  "title": "BlobRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["uri", "media"],
  "properties": {
    "uri": {
      "type": "string",
      "description": "blob:sha256:…, file://… или https://… Слот не обязан понимать все схемы — только те, что заявил в hello."
    },
    "media": {
      "type": "string",
      "examples": ["audio/wav", "audio/pcm", "text/plain"]
    },
    "sample_rate": { "type": "integer", "minimum": 8000 },
    "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
    "bytes": { "type": "integer", "minimum": 0 }
  }
}
